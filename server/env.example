# techsparkx-api production environment variables
# Use these keys for your cPanel Setup Node.js App or .env file

PORT=5000
NODE_ENV=production

# MongoDB Connection (Replace with your Atlas URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/techsparkx?retryWrites=true&w=majority

# Security (Generate a long random string for JWT_SECRET)
JWT_SECRET=your_production_jwt_secret_here

# Third Party Integrations
GOOGLE_CLIENT_ID=your_id.apps.googleusercontent.com
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Frontend URL (For CORS)
CLIENT_URL=https://techsparkx.in
